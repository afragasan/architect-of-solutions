# Server-only. Set in .env.local locally and in Amplify Console for production.
# Never expose with NEXT_PUBLIC_.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Public base URL of the Beehiiv publication. Defaults to the beehiiv.com URL;
# set to https://newsletter.alejandrofraga.com once the custom domain is live.
NEXT_PUBLIC_NEWSLETTER_URL=

NEXT_PUBLIC_SITE_URL=https://alejandrofraga.com
